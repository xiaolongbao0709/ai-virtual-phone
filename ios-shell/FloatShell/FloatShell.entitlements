<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links（Associated Domains）暂时关闭：这个能力要求签名用的证书/描述文件
	     本身支持这项能力，很多基础档位的重签名服务不支持，签出来的包一装就闪退/白屏。

	     等确认你的签名服务支持「Associated Domains」这项能力后，把下面这段取消注释，
	     换成你自己的域名重新走一遍 GitHub 云端编译 + 签名即可开启：

	     <key>com.apple.developer.associated-domains</key>
	     <array>
	         <string>applinks:mianmianfloat.duckdns.org</string>
	     </array>

	     不开启这个功能完全不影响 App 本身的使用——只是点击 Bark 推送里的链接会跳转到
	     Safari 打开，而不是直接跳回这个 App。 -->
</dict>
</plist>
