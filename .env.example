# 自部署默认推荐开启：跳过作者官方账号/激活码系统，使用本地单机账号。
# 作者自己的 Netlify 链接版不要设置这个变量。
NEXT_PUBLIC_SELF_HOSTED_MODE=true

# 可选：仅浏览器 Web Push、旧安卓壳、站点账号/社区等 Supabase 功能需要。
# WebToApp 的 FCM 原生推送已改为使用 Firebase Firestore，不再依赖这两项。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WebToApp 原生通知（Firebase Cloud Messaging HTTP v1 + Firestore 设备 Token 存储）。
# 先在 Firebase 控制台创建 Firestore Database；服务端会自动使用 fcm_devices 集合。
# FIREBASE_PRIVATE_KEY 可直接填写服务账号 JSON 中的 private_key；在 Vercel 中也可保留 \n 转义。
# 这三个变量只放服务端环境变量，绝对不要加 NEXT_PUBLIC_ 前缀。
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# WebToApp 的 FCM 配置页中 authToken 必须与这里完全一致；建议使用至少 32 字节随机值。
# registerUrl 填：https://你的站点域名/api/push/fcm/register
FCM_REGISTER_SECRET=
# TAT1123 自部署单用户默认就是 local_user；除非你改过账号 ID，否则保持不变。
FCM_DEFAULT_USER_ID=local_user

# 独家特调（酒材页 / 配方页）专用的独立 Supabase 项目。特调的表、RPC 与全部读写只认
# 这两个变量，不会回退到上面的主库；不填就等于特调云端未开张。
# 需要先在这个项目的 SQL Editor 执行 docs/mixology-supabase.sql。
MIXOLOGY_SUPABASE_URL=
MIXOLOGY_SUPABASE_SERVICE_ROLE_KEY=

# 可选：现实桥“邮件自动执行”实验模式。先在 Resend 验证自己的发信域名，
# 再配置 API Key 和该域名下的发件地址。验证码密钥建议使用独立随机长字符串。
RESEND_API_KEY=
REALITY_BRIDGE_EMAIL_FROM="Float Reality Bridge <bridge@your-domain.example>"
SHORTCUT_EMAIL_VERIFICATION_SECRET=
# 可选：账号门禁签名密钥。启用账号系统时建议设置为随机长字符串。
ACCOUNT_GATE_SECRET=

# 可选：成年审核/激活码后台管理密钥。
VERIFY_ADMIN_KEY=

# 可选：应用市场审核后台管理密钥。不填时会回退使用 VERIFY_ADMIN_KEY。
APP_MARKET_ADMIN_KEY=

# 可选：启用便签墙实时刷新才需要。注意 NEXT_PUBLIC_* 会公开到浏览器，不要放 service_role。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 可选：第三方能力的服务端兜底 key。一般不用填——用户可在应用内自行填写
# （Tripo 在世界搭建界面，ImgBB 在生图/图床设置）。
TRIPO_API_KEY=
IMGBB_API_KEY=
WEIXIN_PROXY=
NEXT_PUBLIC_IMAGE_GEN_PROXY_URL=
# 可选：网易云音乐 API（NeteaseCloudMusicApi 兼容实例）。留空时在线音乐功能隐藏，
# 用户也可在音乐 APP 设置里自行填写。请部署你自己的实例，不要使用他人的。
NEXT_PUBLIC_DEFAULT_NETEASE_API_BASE=
# 可选：仅当你更换过默认音乐 API 地址时需要。旧地址填这里（逗号分隔），
# 老用户浏览器里存的旧地址会自动迁移到当前默认。
NEXT_PUBLIC_LEGACY_NETEASE_API_BASES=
NEXT_PUBLIC_NETEASE_REAL_IP=
